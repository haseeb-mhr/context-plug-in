# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- PayPal (sandbox REST app: Apps & Credentials -> Sandbox -> create app) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox | production   (default Sandbox; production also requires ALLOW_PRODUCTION=true)
PAYPAL_ENV=Sandbox

# --- NYT (developer portal app with Article Search enabled) ---
NYT_API_KEY=

# --- Local token signing (any random string) ---
UNLOCK_SIGNING_SECRET=

# --- Optional ---
RETURN_URL=https://example.com/unlock/return
CANCEL_URL=https://example.com/unlock/cancel
# Must be true to run against PayPal production. Leave unset for the hackathon.
ALLOW_PRODUCTION=
