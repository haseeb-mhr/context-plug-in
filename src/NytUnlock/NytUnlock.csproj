<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nyt-unlock</AssemblyName>
    <RootNamespace>NytUnlock</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Neither SDK is published to NuGet; both are consumed from a source clone, as the
    dotnet-*-getting-started skills instruct. sdk/ is gitignored — the README carries
    the two clone commands a fresh checkout needs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\sdk\paypal-csharp-sdk\Paypal.csproj" />
    <ProjectReference Include="..\..\sdk\nytimes-csharp-sdk\Nytimes.csproj" />
  </ItemGroup>

</Project>
